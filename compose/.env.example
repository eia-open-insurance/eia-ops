# Copy to .env for local use:  Copy-Item .env.example .env
# These are local development values only. Never commit a real password.
EIA_TAG=local
POSTGRES_USER=eia
POSTGRES_PASSWORD=replace-me-local-only
# Shared HMAC secret for outbox delivery. Change for anything beyond local use.
EIA_EVENT_SIGNING_SECRET=local-event-signing-secret-change-me
